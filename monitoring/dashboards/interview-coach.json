          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, uri) (increase(http_server_requests_seconds_count{namespace=\"interview-coach\", job=\"server\", status=~\"5..\"}[1h])) > 0",
